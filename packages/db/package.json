{
  "name": "@importador/db",
  "version": "0.1.0",
  "description": "Importación con esquema de BD: detecta tablas/columnas/FKs y resuelve relaciones automáticamente (Supabase + adapters).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
